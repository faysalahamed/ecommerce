# Local development environment — SQLite
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://daraz_user:change_me_in_prod@localhost:5432/daraz?schema=public

# Generate a long random string for JWT signing (openssl rand -hex 32)
JWT_SECRET=daraz-clone-dev-secret-change-in-production-2024-a8f3c2e9b1d4

# SMS provider for OTP. Use "demo" in dev (code returned in API response & toast).
# For production, set this to "twilio", "vonage", "sslcompuz", "reve", or "metech"
# and fill in the corresponding credentials below.
SMS_PROVIDER=demo

# Twilio credentials (uncomment & fill in when SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_FROM=

# Vonage credentials (uncomment & fill in when SMS_PROVIDER=vonage)
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# VONAGE_FROM=Daraz

# SSL COMPUZ credentials (uncomment & fill in when SMS_PROVIDER=sslcompuz)
# SSL_COMPUZ_API_KEY=
# SSL_COMPUZ_SID=
# SSL_COMPUZ_FROM=DarazBD

# REVE SMS credentials (uncomment & fill in when SMS_PROVIDER=reve)
# REVE_API_KEY=
# REVE_SENDER_ID=Daraz

# Metech SMS credentials (uncomment & fill in when SMS_PROVIDER=metech)
# METECH_API_KEY=
# METECH_SENDER_ID=Daraz
