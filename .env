# Local development environment — SQLite
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Generate a long random string for JWT signing (openssl rand -hex 32)
JWT_SECRET=shopzilla-dev-secret-change-in-production-2024-a8f3c2e9b1d4

# ============================================================
# Feature flags
# ============================================================

# OTP verification for phone registration:
#   true  (default) — registration requires an OTP sent via SMS to verify the phone
#   false           — registration skips OTP; account is created with phoneVerified=true.
#                     Use this if you haven't yet purchased an SMS provider.
OTP_ENABLED=true

# Session cookie `secure` flag (controls whether the cookie is HTTPS-only):
#   true   — cookie sent ONLY over HTTPS (production best practice, default in NODE_ENV=production)
#   false  — cookie sent over HTTP too (use this if you deployed on HTTP without SSL — e.g., VPS without HTTPS,
#            or testing on a local device over LAN)
# If unset: defaults to (NODE_ENV === 'production')
SESSION_COOKIE_SECURE=false

# ============================================================
# SMS provider credentials (only needed if OTP_ENABLED=true)
# ============================================================
SMS_PROVIDER=demo

# Twilio credentials (uncomment & fill in when SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_FROM=

# Vonage credentials (uncomment & fill in when SMS_PROVIDER=vonage)
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# VONAGE_FROM=ShopZilla

# SSL COMPUZ credentials (uncomment & fill in when SMS_PROVIDER=sslcompuz)
# SSL_COMPUZ_API_KEY=
# SSL_COMPUZ_SID=
# SSL_COMPUZ_FROM=ShopZilla

# REVE SMS credentials (uncomment & fill in when SMS_PROVIDER=reve)
# REVE_API_KEY=
# REVE_SENDER_ID=ShopZilla

# Metech SMS credentials (uncomment & fill in when SMS_PROVIDER=metech)
# METECH_API_KEY=
# METECH_SENDER_ID=ShopZilla
