# Local development environment — SQLite
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://daraz_user:change_me_in_prod@localhost:5432/daraz?schema=public

# Generate a long random string for JWT signing (openssl rand -hex 32)
JWT_SECRET=daraz-clone-dev-secret-change-in-production-2024-a8f3c2e9b1d4

# OTP feature flag.
# true  (default): registration & login require phone OTP verification via SMS
# false           : OTP is skipped — accounts created directly (useful for dev or when no SMS provider)
OTP_ENABLED=false

# Seed endpoint protection. Set any random secret string in production.
# Call POST /api/seed with header: x-seed-secret: <your-secret>
# Leave unset (or empty) in dev to keep the endpoint open.
# SEED_SECRET=your-random-secret-here

# SMS provider for OTP. Use "demo" in dev (code returned in API response & toast).
# For production, set this to "twilio", "vonage", "sslcompuz", "reve", or "metech"
# and fill in the corresponding credentials below.
SMS_PROVIDER=demo

# Twilio credentials (uncomment & fill in when SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_FROM=

# Vonage credentials (uncomment & fill in when SMS_PROVIDER=vonage)
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# VONAGE_FROM=Daraz

# SSL COMPUZ credentials (uncomment & fill in when SMS_PROVIDER=sslcompuz)
# SSL_COMPUZ_API_KEY=
# SSL_COMPUZ_SID=
# SSL_COMPUZ_FROM=DarazBD

# REVE SMS credentials (uncomment & fill in when SMS_PROVIDER=reve)
# REVE_API_KEY=
# REVE_SENDER_ID=Daraz

# Metech SMS credentials (uncomment & fill in when SMS_PROVIDER=metech)
# METECH_API_KEY=
# METECH_SENDER_ID=Daraz


# ==============================================================================
# Social Authentication (OAuth 2.0)
# ==============================================================================
# Base URL of your application (default: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth 2.0 Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Facebook Login Credentials
# Get these from: https://developers.facebook.com/apps/
# Valid OAuth Redirect URI: http://localhost:3000/api/auth/facebook/callback
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
